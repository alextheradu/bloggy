---
import { u } from '../lib/url';
import { MAIN_SITE } from '../lib/config';

const user = Astro.locals.user;
const isAdmin = Astro.locals.isAdmin;
const here = Astro.url.pathname + Astro.url.search;
const initial = (user?.name || '?').trim().charAt(0).toLowerCase();
---

<header class="site">
  <a class="wordmark" href={MAIN_SITE}>
    <span class="arrow" aria-hidden="true">←</span> alexradu.co<span class="slash">/blog</span>
  </a>
  <nav class="site-nav" aria-label="blog">
    <a href={u('/')}>posts</a>
    <span class="sep">/</span>
    <a href={u('/rss.xml')}>rss</a>
    <span class="sep">/</span>
    {
      user ? (
        <details class="user-menu">
          <summary aria-label={`signed in as ${user.name}`}>
            {user.avatarUrl ? (
              <img class="avatar" src={user.avatarUrl} alt="" width="22" height="22" referrerpolicy="no-referrer" />
            ) : (
              <span class="avatar" aria-hidden="true">{initial}</span>
            )}
          </summary>
          <div class="menu">
            <div class="who">
              {user.name}
              <br />
              <span style="font-family: var(--mono); font-size: 0.7rem;">
                via {user.provider === 'hca' ? 'hack club' : 'github'}
              </span>
            </div>
            {isAdmin && <a class="plain" href={u('/admin')}>admin</a>}
            {isAdmin && (
              <form method="post" action={u('/api/admin/posts')}>
                <button type="submit">new post</button>
              </form>
            )}
            <form method="post" action={`${u('/auth/logout')}?next=${encodeURIComponent(here)}`}>
              <button type="submit">log out</button>
            </form>
          </div>
        </details>
      ) : (
        <a href={`${u('/login')}?next=${encodeURIComponent(here)}`} data-login>
          login
        </a>
      )
    }
  </nav>
</header>

<script>
  // close the user menu when clicking elsewhere / pressing escape
  const menu = document.querySelector<HTMLDetailsElement>('.user-menu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false;
    });
  }
</script>
