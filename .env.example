# Copy to .env for local dev:  cp .env.example .env
# Never put real secrets in this file: it is committed.

# ---- core ----
# Public origin browsers use. Drives OAuth redirect URIs, absolute URLs
# (RSS/OG/feed) and the cookie `secure` flag. No trailing slash, no /blog.
# Read at runtime, so the same image works for dev and prod.
PUBLIC_ORIGIN=http://localhost:4321
# Port the node server listens on (= container port in Dokploy).
PORT=4321

# ---- database ----
DATABASE_URL=postgres://blog:blog@localhost:5442/blog

# ---- auth ----
# Hack Club Auth app (https://auth.hackclub.com/developer/apps)
#   redirect uri: ${PUBLIC_ORIGIN}/blog/auth/callback/hca
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
# GitHub OAuth app (https://github.com/settings/developers)
#   callback url: ${PUBLIC_ORIGIN}/blog/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Admin allowlist, comma separated.
#   HCA ids look like ident!AbC123 (see DEPLOY.md to find yours)
#   GitHub ids are numeric: curl https://api.github.com/users/<you> | jq .id
ADMIN_HCA_IDS=
ADMIN_GITHUB_IDS=

# ---- object storage (any S3 API: RustFS / MinIO / Garage) ----
# dev: RustFS from docker-compose.dev.yml (bucket is auto-created on first write)
S3_ENDPOINT=http://localhost:9040
S3_REGION=us-east-1
S3_BUCKET=blog
S3_ACCESS_KEY=blog
S3_SECRET_KEY=blogblogblog

# ---- optional ----
# CACHET_URL=https://cachet.hackclub.com
